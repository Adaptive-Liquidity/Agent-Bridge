{
  "name": "@adaptive-liquidity/agent-bridge",
  "version": "0.5.0",
  "private": true,
  "description": "Policy-first MCP control plane for scoped agent work.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:core && npm run build:serverless",
    "build:core": "tsc -p tsconfig.json",
    "build:serverless": "tsc -p tsconfig.serverless.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "start:local-http": "node dist/local-http.js",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
